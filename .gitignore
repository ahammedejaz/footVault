# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/

# Environment
# Catch-all, deliberately. The named-file approach here missed .env.staging
# once (and backup-*.sql below for the same reason): every new shape had to be
# remembered. Anything starting .env is a secret unless excepted on the next
# line. This now covers .env.production and .env.development, which the old
# `.env.*.local` pattern did not.
.env*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/
.idea/
*.swp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Claude Code local overrides
.claude/settings.local.json

# Supabase
.branches
.temp

# Next.js / Vercel
/.next/
/out/
.vercel
*.tsbuildinfo
next-env.d.ts
.pnp.*
.yarn/*
/coverage
*.pem

# Ad-hoc screenshots taken while testing. Audit output goes to a temp dir.
screenshots/

# Generated by next.config (agentRules) — build artefacts, not source.
AGENTS.md
CLAUDE.md

# Subagent worktrees.
.claude/worktrees/

# database dumps — real customer names, addresses and phone numbers.
# Never in the repository. See docs/admin-guide.md section 12.
backup-*.sql
*.dump

# Playwright MCP scratch output (snapshots, console logs)
.playwright-mcp/
