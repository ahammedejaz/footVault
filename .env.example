# Copy to .env.local and fill in. .env.local is gitignored — never commit values.

# Supabase — project ref is ahumjhwqgmskjsitctcj
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security.
# Never expose this to the browser: no NEXT_PUBLIC_ prefix, never imported into
# a client component, never referenced outside src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin, used for metadataBase, OG images and the sitemap.
# http://localhost:3000 in development.
#
# Not used for the OAuth redirect: that is built from the request's forwarded
# host instead, so every Vercel preview signs back in to itself rather than to
# production. This is the fallback for contexts with no request (build-time
# metadata, the sitemap).
NEXT_PUBLIC_SITE_URL=

# --- Google sign-in ----------------------------------------------------------
#
# Nothing goes here. The client ID and secret live in the Supabase dashboard
# (Authentication -> Providers -> Google), not in this app — the app never sees
# them, and never should. The redirect URLs that have to be allow-listed
# alongside them are listed in README.md under "What is blocked".

# --- Razorpay ----------------------------------------------------------------
#
# Names only. Values live in .env.local for development and in the Vercel
# project for deployments — set separately for Preview and Production, so a
# preview can never take a live payment.
#
# The key id is the publishable half of the pair. It reaches the browser, but
# only as part of a payment initiation the server returns — there is
# deliberately no NEXT_PUBLIC_ variable for it, which keeps it off every page
# that is not actually taking a payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret from RAZORPAY_KEY_SECRET, and the single most common thing
# to get wrong here. It signs the x-razorpay-signature header on incoming
# webhook events, and only that — verifying a webhook with the key secret fails
# every time and looks like a network problem.
#
# You invent this value; Razorpay does not generate it for you. Produce one with
# `openssl rand -hex 32`, then paste the same string into Razorpay Dashboard ->
# Account & Settings -> Website and app settings -> Webhooks -> Add New Webhook,
# and into the environment here. Use a different secret per environment.
#
# Leave it blank and the webhook route rejects everything with a 400, which is
# the correct direction to fail: an unverifiable endpoint that confirmed orders
# would confirm anybody's.
RAZORPAY_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------------
#
# Nothing reads these yet, and they are here rather than absent on purpose:
# getEmailAdapter() in src/lib/email/index.ts returns the console adapter today,
# so every order confirmation is printed to the server log and no order is ever
# affected by a missing provider. These are the two names the real adapter will
# read, listed so the owner knows what to create rather than discovering it
# after the first customer does not get a receipt.
#
# The four steps to wire a provider are in the header of src/lib/email/index.ts.
# Verify the sending domain (SPF + DKIM) before setting either of these;
# skipping that is what puts order confirmations in spam.
EMAIL_API_KEY=
EMAIL_FROM=

# --- Indexing ----------------------------------------------------------------
#
# Default, and the default for anything unset or misspelled, is noindex: the
# store is publicly reachable long before it is ready, and a page indexed with
# placeholder illustrations outlives the deploy that caused it.
#
# To go live: set this to exactly "true" in the Vercel project (Production only,
# so previews stay hidden) and redeploy. That is the whole change.
SITE_INDEXABLE=false
